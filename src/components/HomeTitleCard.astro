---
import ashik from '../assets/ashik.webp';
import '@fontsource-variable/oswald';
import '@fontsource-variable/inter';

interface Props {
  firstName?: string;
  lastName?: string;
  role?: string;
  experience?: string;
  description?: string;
  imageUrl?: ImageMetadata | string;
}

const {
  firstName = "ASHIQ",
  lastName = "MOHANAN",
  role = "UI/UX/Graphic Designer",
  experience = "5 Years",
  description = "I'm Ashiq — a creative Visual & Digital Designer skilled in UI/UX, SaaS illustrations, and marketing design. I combine creativity with strategy to craft impactful, user-focused experiences.",
  imageUrl = ashik
} = Astro.props;

const resolvedImageUrl = typeof imageUrl === 'string' ? imageUrl : imageUrl.src;
---

<div class="id-card-wrapper">

  <!-- LEFT PANEL -->
  <div class="card left-panel">
    <!-- Top Left Tab -->
    <div class="top-tab">
      <span>Fraud</span> <strong>Shield</strong>
    </div>

    <!-- Photo + Overlay -->
    <div class="image-container">
      {imageUrl ? (
        <img src={resolvedImageUrl} alt={`${firstName} ${lastName}`} class="profile-img" />
      ) : (
        <div class="image-placeholder">
          <span>Image Placeholder</span>
        </div>
      )}
     
    </div>

    <!-- Bottom Name -->
    <div class="bottom-tab">
      <span class="name-text">{firstName}</span>
      <span class="name-text">{lastName}</span>
    </div>
  </div>

  <!-- RIGHT PANEL -->
  <div class="card right-panel">
    <!-- Top Right Name -->
    <div class="top-right-name">
      {firstName}
      <br />
      {lastName}
    </div>

    <div class="info-container">
      <!-- Title Section -->
      <div class="section">
        <div class="label-bar">TITLE</div>
        <div class="content-bar text-lg">{role}</div>
      </div>

      <!-- Experience Section -->
      <div class="section row-section">
        <div class="label-bar">EXPERIENCE</div>
        <div class="content-bar text-center font-medium">{experience}</div>
      </div>

      <!-- Description Section -->
      <div class="section">
        <div class="label-bar">DESCRIPTION</div>
        <div class="content-bar description-text">{description}</div>
      </div>
    </div>

    <!-- Floating Hindi Badge -->
    <div class="hindi-badge">डिज़ाइनर</div>
  </div>

</div>

<style>
  .id-card-wrapper {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 19.34px;
    font-family: 'Inter Variable', sans-serif;
  }

  .card {
    width: 354.5px;
    height: 495.5px;
    position: relative;
    border-radius: 10px;
    overflow: hidden;
  }

  /* --- LEFT PANEL --- */

  .left-panel {
    background: linear-gradient(180deg, #0c0c0c 0%, #6b6b6b 46.63%, #000000 97.12%, #363636 100%);
    clip-path: polygon(
      8px 0,
      298px 0,
      354.5px 54px,
      354.5px 486px,
      346px 495.5px,
      8px 495.5px,
      0 486px,
      0 8px
    );
  }

  .top-tab {
    position: absolute;
    top: 12.89px;
    left: 19.34px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: #fff;
    font-size: 13.09px;
    font-weight: 400;
    letter-spacing: 0.5px;
    z-index: 10;
  }

  .shield-icon {
    width: 13px;
    height: 15px;
    flex: none;
  }

  .image-container {
    position: absolute;
    inset: 22.56px 19.34px;
    overflow: hidden;
    z-index: 1;
    clip-path: polygon(
      0% 3.05%,
      28.83% 3.05%,
      32.14% 0%,
      85% 0%,
      100% 10.93%,
      100% 100%,
      34.94% 100%,
      34.94% 93.91%,
      19.9% 85.3%,
      0% 85.3%
    );
  }

  .profile-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(72, 72, 72, 0) 50.18%, #161616 121.15%);
    backdrop-filter: blur(10.39px);
  }

  .image-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #666;
    background: repeating-linear-gradient(45deg, #1a1a1a, #1a1a1a 10px, #222 10px, #222 20px);
  }

  .bottom-tab {
    position: absolute;
    left: 19.97px;
    bottom: 23px;
    display: flex;
    flex-direction: column;
    color: #fff;
    font-family: 'Oswald Variable', sans-serif;
    font-size: 26.5px;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    z-index: 10;
  }

  /* --- RIGHT PANEL --- */

  .right-panel {
    background: linear-gradient(180deg, #0c0c0c 0%, #6b6b6b 46.63%, #000000 97.12%, #363636 100%);
    clip-path: polygon(
      346px 0,
      57.09px 0,
      50.31px 2.66px,
      3.22px 46.18px,
      0 53.52px,
      0 486px,
      8px 495.5px,
      346px 495.5px,
      354.5px 486px,
      354.5px 8px
    );
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding: 19.34px;
    gap: 19.34px;
  }

  .top-right-name {
    text-align: right;
    color: #fff;
    font-family: 'Oswald Variable', sans-serif;
    font-size: 26px;
    font-weight: 700;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .info-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    gap: 19.34px;
  }

  .section {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    gap: 3.22px;
  }

  .row-section {
    flex-direction: row;
    gap: 3.22px;
  }

  .label-bar {
    display: flex;
    align-items: center;
    align-self: stretch;
    padding: 6.45px 12.89px;
    background: #d14277;
    color: #fff;
    font-size: 13.12px;
    font-weight: 600;
    letter-spacing: 0.5px;
  }

  .row-section .label-bar {
    flex: 1;
    min-width: 0;
  }

  .content-bar {
    align-self: stretch;
    padding: 11.28px 12.89px;
    background: #d14277;
    color: #000;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .row-section .content-bar {
    flex: 2;
    flex-basis: 0;
    padding: 6.45px 12.89px;
  }

  .text-lg {
    font-size: 18px;
  }

  .description-text {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.55;
  }

  .text-center {
    text-align: center;
  }

  .font-medium {
    font-weight: 500;
  }

  /* --- Hindi Badge --- */

  .hindi-badge {
    position: absolute;
    right: 12px;
    bottom: 12px;
    font-family: 'Inter Variable', sans-serif;
    font-size: 30px;
    font-weight: 900;
    color: #fff;
    transform: rotate(-10deg);
    -webkit-text-stroke: 5px #2258f0;
    paint-order: stroke fill;
    letter-spacing: 2px;
    filter: drop-shadow(-1px 4px 0 #2e0199) drop-shadow(-1px 3px 3.5px rgba(0, 0, 0, 0.33));
    z-index: 20;
    white-space: nowrap;
  }

  /* --- Responsive --- */

  @media (max-width: 820px) {
    .id-card-wrapper {
      gap: 12px;
    }
    .card {
      width: 300px;
      height: 419px;
    }
    .bottom-tab {
      font-size: 22px;
    }
    .top-right-name {
      font-size: 22px;
    }
  }

  @media (max-width: 680px) {
    .id-card-wrapper {
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>