---
import { Image } from 'astro:assets';
import contactBg from '../../../assets/contact-bg.webp';
---

<section id="contact" class="section">
	<Image
		src={contactBg}
		alt=""
		quality="high"
		class="bg"
		aria-hidden="true"
	/>
	<div class="content">
		<div class="card">
			<div class="inner">
				<div class="intro">
					<h2 class="heading">Have a project in mind?</h2>
					<div class="copy">
						<p class="desc">
							I can help designing a website, designing a new product,
							improving an existing part of your product, building a
							strong design system,
						</p>
						<p class="loc">Currently based in Kochi, Kerala</p>
					</div>
				</div>

				<div class="actions">
					<a class="btn btn--primary" href="#">
						Get in touch
					</a>
					<a class="btn btn--outline" href="#">
						<svg
							viewBox="0 0 13.5 13.5"
							width="13.5"
							height="13.5"
							aria-hidden="true"
						>
							<path
								d="M2.25 2.25 H11.25 V4.2 H2.25 Z M6.75 4.2 V10.5 M4.6 8.4 L6.75 10.5 L8.9 8.4"
								fill="none"
								stroke="#FFFFFF"
								stroke-width="1.125"
							/>
						</svg>
						Download CV
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.section {
		position: relative;
		min-height: 100vh;
		overflow: hidden;
	}

	.bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.content {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 100vh;
		padding: var(--stack-large);
	}

	.card {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		padding: 40px;
		gap: 40px;

		width: min(812px, 100%);
		max-width: 812px;

		background: rgba(0, 0, 0, 0.22);
		border-radius: 17px;
	}

	.inner {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		padding: 0;
		gap: 40px;
		width: 100%;
	}

	.intro {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		gap: 12px;
	}

	.heading {
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 40px;
		line-height: 100%;
		color: #ffffff;
	}

	.copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 12px;
	}

	.desc,
	.loc {
		width: 252px;
		font-family: var(--font-body);
		font-weight: 400;
		font-size: 14px;
		line-height: 17px;
		letter-spacing: -0.02em;
		color: #ffffff;
	}

	.actions {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 4px;
	}

	.btn {
		display: flex;
		flex-direction: row;
		justify-content: center;
		align-items: center;
		text-decoration: none;
		gap: 5.62px;
		padding: 6.75px 9px;
		border-radius: 4.5px;

		font-family: var(--font-nav);
		font-weight: 900;
		font-size: 13.5px;
		line-height: 18px;
		color: #ffffff;
	}

	.btn--primary {
		background: #000000;
	}

	.btn--outline {
		border: 0.5625px solid #ffffff;
	}

	.section::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 200px;
		z-index: 1;
		background: linear-gradient(
			to bottom,
			var(--surface) 0%,
			var(--surface) 40%,
			transparent 100%
		);
		pointer-events: none;
	}

	@media (max-width: 768px) {
		.card {
			padding: var(--stack-large);
			gap: var(--stack-large);
		}

		.intro {
			flex-direction: column;
			align-items: flex-start;
		}

		.heading {
			font-size: 24px;
		}

		.desc,
		.loc {
			width: 100%;
		}

		.actions {
			flex-wrap: wrap;
		}
	}
</style>