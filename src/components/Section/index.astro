---
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section">
	<h2 class:list={['title', 'text-display-xl']}>{title}</h2>
	<slot />
</section>

<style>
	.section {
		margin-bottom: var(--padding-section-v);
	}

	.title {
		margin-bottom: var(--stack-large);
		padding-bottom: var(--stack-base);
		border-bottom: var(--border-default);
	}
</style>